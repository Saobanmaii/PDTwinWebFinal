# Copy thành application-secret.properties và điền giá trị thật (file đó không được commit).
spring.datasource.password=your-mysql-password
# Chuỗi ngẫu nhiên dài >= 32 ký tự để ký JWT
app.jwt.secret=change-me-to-a-long-random-string-at-least-32-chars
# Ảnh snapshot của camera thiết bị thật (tùy chọn)
app.camera.url=http://camera-host:8080/cam/snapshot.jpg
